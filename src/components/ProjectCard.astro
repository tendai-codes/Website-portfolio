---
const { project, index = 0 } = Astro.props;
const slug = project.id.replace(/\.md$/, '');
---
<article class="project-card reveal" style={`--delay:${Math.min(index,6)*50}ms`} data-category={project.data.category}>
  <a class={`project-visual visual-${project.data.visual}`} href={`/projects/${slug}/`} aria-label={`View ${project.data.title}`}>
    <span class="visual-index">{String(index + 1).padStart(2,'0')}</span>
    <span class="visual-word">{project.data.category}</span>
    <i></i><i></i><i></i><i></i><i></i>
  </a>
  <div class="project-card-body">
    <div class="eyebrow-row"><span>{project.data.category}</span><span>Case study</span></div>
    <h3><a href={`/projects/${slug}/`}>{project.data.title}</a></h3>
    <p>{project.data.description}</p>
    <div class="tag-row">{project.data.technologies.slice(0,4).map((t:string) => <span>{t}</span>)}</div>
    <a class="text-link" href={`/projects/${slug}/`}>View project <span>↗</span></a>
  </div>
</article>
