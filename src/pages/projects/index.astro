---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);

const categories = [
  'All',
  ...new Set(projects.map((project) => project.data.category)),
];
---

<BaseLayout
  title="Projects — Tendai Sibanda"
  description="Technical case studies across bioinformatics, modelling, machine learning, deep learning and data analysis."
>
  <section class="page-hero section-pad">
    <p class="section-label">Projects</p>
    <h1>Work that shows the <em>reasoning</em>, not the notebook.</h1>
    <p class="hero-copy">
      Technical case studies built around context, method, selected implementation,
      evidence, limitations and what I learned. GitHub holds the complete source;
      these pages explain why the work was built the way it was.
    </p>
  </section>

  <section class="section-pad page-listing">
    <div
      class="filter-row"
      data-filter-group
      data-target=".project-card"
    >
      {categories.map((category) => (
        <button
          class:list={['filter-chip', { active: category === 'All' }]}
          data-filter={category}
        >
          {category}
        </button>
      ))}
    </div>

    <div class="project-grid all-projects">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>
</BaseLayout>
