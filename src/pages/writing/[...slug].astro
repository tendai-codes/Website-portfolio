---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
export async function getStaticPaths(){
  const posts=(await getCollection('blog')).filter(p=>!p.data.draft);
  return posts.map(post=>({params:{slug:post.id.replace(/\.md$/,'')},props:{post}}));
}
const { post }=Astro.props;
const projects=await getCollection('projects');
const related=post.data.relatedProject?projects.find(p=>p.id.replace(/\.md$/,'')===post.data.relatedProject):undefined;
const { Content }=await render(post);
---
<BlogPost post={post} related={related}><Content /></BlogPost>
